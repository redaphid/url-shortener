#!/usr/bin/env fish

set namespace "e239df04697f45d78631c29760c1a5b9"
set script_dir (status dirname)

if test (count $argv) -lt 1
    echo "Usage:"
    echo "  short <path> <url>   Set 2cb.pw/<path> → <url>"
    echo "  short get <path>     Get the URL for 2cb.pw/<path>"
    exit 1
end

cd $script_dir

if test "$argv[1]" = "get"
    if test (count $argv) -ne 2
        echo "Usage: short get <path>"
        exit 1
    end
    npx wrangler kv key get --namespace-id=$namespace --remote "$argv[2]"
else
    if test (count $argv) -ne 2
        echo "Usage: short <path> <url>"
        exit 1
    end
    npx wrangler kv key put --namespace-id=$namespace --remote "$argv[1]" "$argv[2]"
    and echo "✓ 2cb.pw/$argv[1] → $argv[2]"
end
